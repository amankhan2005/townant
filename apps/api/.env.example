# ---- Core ----
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
# Must be a replica set (transactions). Local: `npm run db:dev -w @townant/api`.
# Atlas (Connect → Drivers), with the database named before the "?":
#   mongodb+srv://<user>:<url-encoded-password>@<cluster-host>/townant_dev_seed?retryWrites=true&w=majority
#   Replace the whole <db_password> placeholder, angle brackets included. URL-encode @ : / ? # [ ] % in the password.
# Declare MONGODB_URI once, here. A MONGODB_URI exported in the shell overrides this file.
# Check what the API and seed will use (never prints secrets): npm run env:check -w @townant/api -- --ping
MONGODB_URI=mongodb://127.0.0.1:27018/townant?replicaSet=rs0
# Public origin of the web app, used in email links. https:// required in production.
APP_BASE_URL=http://localhost:5173
# Comma-separated browser origins allowed to call the API with credentials.
CORS_ORIGINS=http://localhost:5173
# Reverse-proxy hops in front of the API (e.g. 1 behind a single load balancer). 0 = trust none.
TRUST_PROXY_HOPS=0
# Must be true in production (HTTPS). false only for plain-http local development.
COOKIE_SECURE=false
COOKIE_DOMAIN=
# Random secret >= 32 chars for OTP/IP HMACs. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
OTP_PEPPER=
# Development only: print OTP codes/emails to the console when providers are not configured.
DEV_PRINT_OTP=true
# Run background jobs (notification delivery, reminders, request expiry) in the API process.
RUN_WORKER=true
OTP_DAILY_GLOBAL_CAP=10000

# ---- Resend (email OTP + transactional email). Required in production. ----
RESEND_API_KEY=
EMAIL_FROM="TownAnt <no-reply@your-verified-domain.com>"
# Webhook signing secret (whsec_...) for delivery status events at /api/webhooks/resend
RESEND_WEBHOOK_SECRET=

# ---- Meta WhatsApp Business Platform (phone OTP). Phone sign-in is disabled until set. ----
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Name of an approved AUTHENTICATION template with a copy-code button.
WHATSAPP_OTP_TEMPLATE=
WHATSAPP_TEMPLATE_LANG=en_US
WHATSAPP_API_VERSION=v23.0
# App secret used to verify X-Hub-Signature-256 on /api/webhooks/whatsapp
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=

# ---- OpenAI (discovery assistant, voice transcription, writing help). Features show a fallback until set. ----
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Speech-to-text for the assistant's microphone button.
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
AI_DAILY_REQUEST_CAP=5000

# ---- Cloudinary (vendor images). Uploads are disabled until set. ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- Expo push (optional access token if "enhanced push security" is enabled) ----
EXPO_ACCESS_TOKEN=

# ---- Development seed (npm run seed:dev -w @townant/api). Never set these in production. ----
# Put these in apps/api/.env.seed (git-ignored, read only by seed:dev, after this file). The seed refuses unless
# ALLOW_DEV_SEED=true and NODE_ENV is not production, and MONGODB_URI is a local server or the Atlas database named
# exactly townant_dev_seed with CONFIRM_ATLAS_DEV_SEED=townant_dev_seed. Passwords: 12+ characters. See docs/DEV_SEED.md.
ALLOW_DEV_SEED=
CONFIRM_ATLAS_DEV_SEED=
DEV_SUPER_ADMIN_EMAIL=admin@townant.test
DEV_SUPER_ADMIN_PASSWORD=
DEV_VENDOR_PASSWORD=
