{
  "name": "@townant/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "worker": "node --env-file-if-exists=.env src/worker.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src test scripts",
    "admin:create": "node --env-file-if-exists=.env scripts/create-admin.js",
    "seed:categories": "node --env-file-if-exists=.env scripts/seed-categories.js",
    "seed:dev": "node --env-file-if-exists=.env --env-file-if-exists=.env.seed scripts/seed-dev.js",
    "env:check": "node scripts/check-env.js",
    "db:dev": "node scripts/dev-mongo.js",
    "reset:dev": "node --env-file-if-exists=.env --env-file-if-exists=.env.seed scripts/reset-dev-marketplace.js"
  },
  "dependencies": {
    "@townant/shared": "*",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "libphonenumber-js": "^1.13.15",
    "luxon": "^3.7.2",
    "mongoose": "^8.24.7",
    "multer": "^2.5.0",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "write-excel-file": "^4.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "mongodb-memory-server": "^11.3.0",
    "supertest": "^7.3.1",
    "vitest": "^5.0.5"
  }
}
