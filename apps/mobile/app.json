{
  "expo": {
    "name": "TownAnt",
    "slug": "townant",
    "scheme": "townant",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.townant.app",
      "supportsTablet": false,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "TownAnt uses your location to show nearby services. You can always search by city or ZIP code instead."
      }
    },
    "android": {
      "package": "com.townant.app",
      "permissions": [
        "ACCESS_COARSE_LOCATION"
      ],
      "blockedPermissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "TownAnt uses your location to show nearby services. You can always search by city or ZIP code instead."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#147D73"
        }
      ],
      [
        "expo-font",
        {
          "android": {
            "fonts": [
              {
                "fontFamily": "Inter",
                "fontDefinitions": [
                  {
                    "path": "node_modules/@expo-google-fonts/inter/400Regular/Inter_400Regular.ttf",
                    "weight": 400
                  },
                  {
                    "path": "node_modules/@expo-google-fonts/inter/500Medium/Inter_500Medium.ttf",
                    "weight": 500
                  },
                  {
                    "path": "node_modules/@expo-google-fonts/inter/600SemiBold/Inter_600SemiBold.ttf",
                    "weight": 600
                  },
                  {
                    "path": "node_modules/@expo-google-fonts/inter/700Bold/Inter_700Bold.ttf",
                    "weight": 700
                  }
                ]
              },
              {
                "fontFamily": "Manrope",
                "fontDefinitions": [
                  {
                    "path": "node_modules/@expo-google-fonts/manrope/600SemiBold/Manrope_600SemiBold.ttf",
                    "weight": 600
                  },
                  {
                    "path": "node_modules/@expo-google-fonts/manrope/700Bold/Manrope_700Bold.ttf",
                    "weight": 700
                  },
                  {
                    "path": "node_modules/@expo-google-fonts/manrope/800ExtraBold/Manrope_800ExtraBold.ttf",
                    "weight": 800
                  }
                ]
              }
            ]
          },
          "ios": {
            "fonts": [
              "node_modules/@expo-google-fonts/inter/400Regular/Inter_400Regular.ttf",
              "node_modules/@expo-google-fonts/inter/500Medium/Inter_500Medium.ttf",
              "node_modules/@expo-google-fonts/inter/600SemiBold/Inter_600SemiBold.ttf",
              "node_modules/@expo-google-fonts/inter/700Bold/Inter_700Bold.ttf",
              "node_modules/@expo-google-fonts/manrope/600SemiBold/Manrope_600SemiBold.ttf",
              "node_modules/@expo-google-fonts/manrope/700Bold/Manrope_700Bold.ttf",
              "node_modules/@expo-google-fonts/manrope/800ExtraBold/Manrope_800ExtraBold.ttf"
            ]
          }
        }
      ]
    ]
  }
}
